# ==========================================
# Stage 1: Install Dependencies
# ==========================================
FROM node:{{ runtime_version | default('20') }}-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

{% if package_manager == 'pnpm' %}
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
{% elif package_manager == 'yarn' %}
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
{% else %}
COPY package*.json ./
RUN npm ci
{% endif %}

# ==========================================
# Stage 2: Build Application
# ==========================================
FROM node:{{ runtime_version | default('20') }}-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
RUN {{ build_command | default('npm run build') }}

# ==========================================
# Stage 3: Production Runner
# ==========================================
FROM node:{{ runtime_version | default('20') }}-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT={{ default_port | default(3000) }}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy public assets and built standalone if present
COPY --from=builder /app/public ./public 2>/dev/null || true
COPY --from=builder /app/.next/standalone ./ 2>/dev/null || true
COPY --from=builder /app/.next/static ./.next/static 2>/dev/null || true
COPY --from=builder /app/node_modules ./node_modules 2>/dev/null || true
COPY --from=builder /app/package.json ./package.json

USER nextjs

EXPOSE {{ default_port | default(3000) }}

CMD ["node", "server.js"]
