name: Continuous Integration

on:
  push:
    branches: [ main, master, dev ]
  pull_request:
    branches: [ main, master ]

jobs:
{% for service in services %}
  test-{{ service.name }}:
    name: Test & Lint ({{ service.name }})
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

{% if service.language == 'typescript' or service.language == 'javascript' %}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '{{ service.runtime_version | default("20") }}'
          cache: '{{ service.package_manager }}'

      - name: Install Dependencies
        working-directory: {{ service.path }}
        run: |
          {% if service.package_manager == 'pnpm' %}
          pnpm install --frozen-lockfile
          {% elif service.package_manager == 'yarn' %}
          yarn install --frozen-lockfile
          {% else %}
          npm ci
          {% endif %}

{% if service.test_command %}
      - name: Run Tests
        working-directory: {{ service.path }}
        run: {{ service.test_command }}
{% endif %}

{% if service.build_command %}
      - name: Run Build
        working-directory: {{ service.path }}
        run: {{ service.build_command }}
{% endif %}

{% elif service.language == 'python' %}
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '{{ service.runtime_version | default("3.11") }}'
          cache: 'pip'

      - name: Install Dependencies
        working-directory: {{ service.path }}
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          pip install pytest

{% if service.test_command %}
      - name: Run Tests
        working-directory: {{ service.path }}
        run: {{ service.test_command }}
{% endif %}
{% endif %}

      - name: Verify Docker Build
        working-directory: {{ service.path }}
        run: docker build -t {{ repo_name }}-{{ service.name }}:ci .
{% endfor %}
