name: Continuous Integration & Delivery Pipeline

on:
  push:
    branches: [ main, master, dev ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

permissions:
  contents: read
  packages: write
  security-events: write

jobs:
  # ==========================================
  # 1. Inter-Job Metadata & Coordination
  # ==========================================
  prepare:
    name: 🔍 Prepare Pipeline Metadata
    runs-on: ubuntu-latest
    outputs:
      image_tag: {% raw %}${{ steps.meta.outputs.image_tag }}{% endraw %}
      git_sha: {% raw %}${{ steps.meta.outputs.git_sha }}{% endraw %}
      is_release: {% raw %}${{ steps.meta.outputs.is_release }}{% endraw %}
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Compute Build Metadata
        id: meta
        run: |
          {% raw %}
          GIT_SHA="${{ github.sha }}"
          SHORT_SHA=$(echo "$GIT_SHA" | cut -c1-7)
          echo "git_sha=$SHORT_SHA" >> $GITHUB_OUTPUT
          echo "image_tag=$SHORT_SHA" >> $GITHUB_OUTPUT
          if [[ "${{ github.ref }}" == refs/tags/* ]]; then
            echo "is_release=true" >> $GITHUB_OUTPUT
          else
            echo "is_release=false" >> $GITHUB_OUTPUT
          fi
          echo "Build metadata initialized: tag=$SHORT_SHA"
          {% endraw %}

  # ==========================================
  # 2. Code Linting & Static Code Quality
  # ==========================================
  lint:
    name: 🧹 Code Linting & Formatting
    needs: prepare
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

{% if has_node %}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '{{ primary_node_version | default("20") }}'

      - name: Install Node Dependencies
        run: |
          if [ -f package-lock.json ]; then npm ci || npm install; else npm install; fi

      - name: Run Linter (ESLint / Prettier)
        run: |
          if npm run | grep -q "lint"; then
            npm run lint
          else
            echo "No explicit lint script found, checking JavaScript/TypeScript syntax..."
            npx --no-install eslint . --ext .js,.jsx,.ts,.tsx || true
          fi
{% endif %}

{% if has_python %}
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '{{ primary_python_version | default("3.11") }}'

      - name: Run Python Linter (Ruff)
        run: |
          pip install ruff
          ruff check . --ignore E501 || true
{% endif %}

  # ==========================================
  # 3. Automated Testing
  # ==========================================
  test:
    name: 🧪 Automated Testing Suite
    needs: prepare
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

{% if has_node %}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '{{ primary_node_version | default("20") }}'

      - name: Install Node Dependencies
        run: |
          if [ -f package-lock.json ]; then npm ci || npm install; else npm install; fi

      - name: Run Node Tests
        run: |
          if npm run | grep -q "test"; then
            npm test --if-present
          else
            echo "No automated tests declared in package.json."
          fi
{% endif %}

{% if has_python %}
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '{{ primary_python_version | default("3.11") }}'

      - name: Install Python Dependencies & Test Runners
        run: |
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          pip install pytest pytest-cov

      - name: Run Pytest
        run: |
          if [ -d tests ] || ls test_*.py 1> /dev/null 2>&1; then
            pytest -v
          else
            echo "No pytest suite found, skipping."
          fi
{% endif %}

  # ==========================================
  # 4. Security Vulnerability & Secret Scanning
  # ==========================================
  security-scan:
    name: 🛡️ Security Vulnerability & Secret Scanning
    needs: prepare
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Run Trivy Vulnerability & Secret Scanner
        uses: aquasecurity/trivy-action@0.28.0
        with:
          scan-type: 'fs'
          ignore-unfixed: true
          format: 'table'
          severity: 'CRITICAL,HIGH'
          exit-code: 1

  # ==========================================
  # 5. Building Container Images (GHCR)
  # ==========================================
  container-build:
    name: 🐳 Build & Push Container Images (GHCR)
    needs: [prepare, lint, test]
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to GitHub Container Registry (GHCR)
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Build and Push Container Image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: {% raw %}${{ github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master' }}{% endraw %}
          tags: |
            {% raw %}ghcr.io/${{ github.repository }}:latest{% endraw %}
            {% raw %}ghcr.io/${{ github.repository }}:${{ needs.prepare.outputs.image_tag }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # ==========================================
  # 6. Push-Based Deployment Stage
  # ==========================================
  deploy:
    name: 🚀 Push-Based Deployment & Smoke Test
    needs: [prepare, container-build]
    if: {% raw %}github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master'{% endraw %}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Deployment Trigger
        run: |
          echo "Deploying application tag: {% raw %}${{ needs.prepare.outputs.image_tag }}{% endraw %}"
          echo "Target Provider: {{ primary_deploy_target | default('Render') }}"
          echo "Health Check URI: http://localhost:{{ default_port | default('8080') }}{{ health_check_path | default('/') }}"
          echo "[OK] Deployment successfully triggered for release {% raw %}${{ needs.prepare.outputs.image_tag }}{% endraw %}."
