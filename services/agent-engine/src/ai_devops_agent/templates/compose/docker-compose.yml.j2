services:
{% if has_postgres %}
  db:
    image: postgres:15-alpine
    container_name: {{ repo_name }}-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: postgres
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: "1234"
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 3s
      timeout: 3s
      retries: 5
{% endif %}

{% for service in services %}
  {{ service.name }}:
    build:
      context: {{ service.path }}
      dockerfile: Dockerfile
    container_name: {{ repo_name }}-{{ service.name }}
    restart: unless-stopped
{% if has_postgres %}
    depends_on:
      db:
        condition: service_healthy
{% endif %}
    ports:
      - "{{ service.host_port | default(service.default_port) }}:{{ service.default_port }}"
    environment:
      - PORT={{ service.default_port }}
{% if has_postgres %}
      - DB_HOST=db
      - DATABASE_URL=postgres://postgres:1234@db:5432/postgres
{% endif %}
{% if service.env_vars_detected %}
    env_file:
      - path: {{ service.path }}/.env
        required: false
{% endif %}
{% endfor %}

{% if has_postgres %}
volumes:
  postgres_data:
{% endif %}
